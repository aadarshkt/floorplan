{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cozmo.example/schema/floorplan.schema.json",
  "title": "Cozmo Floor Plan Result",
  "description": "Output contract for one capture. All lengths in metres.",
  "type": "object",
  "required": ["schema_version", "capture_id", "tier", "units", "property", "rooms"],
  "properties": {
    "schema_version": { "type": "string" },
    "capture_id": { "type": "string" },
    "tier": { "type": "string", "enum": ["lidar", "photos", "video"] },
    "units": { "type": "string", "enum": ["meters"] },
    "property": {
      "type": "object",
      "required": ["footprint_area_m2", "rooms", "adjacency"],
      "properties": {
        "footprint_area_m2": { "$ref": "#/definitions/measurement" },
        "rooms": { "type": "array", "items": { "type": "string" } },
        "adjacency": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "a": {"type": "string"}, "b": {"type": "string"}, "via": {"type": "string"} }
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["room_id", "polygon", "floor_area_m2", "ceiling_height_m", "walls"],
        "properties": {
          "room_id": { "type": "string" },
          "polygon": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
          "floor_area_m2": { "$ref": "#/definitions/measurement" },
          "ceiling_height_m": {
            "allOf": [
              { "$ref": "#/definitions/measurement" },
              { "type": "object", "properties": { "observed": { "type": "boolean" } } }
            ]
          },
          "walls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["wall_id", "start", "end", "length_m", "openings"],
              "properties": {
                "wall_id": { "type": "string" },
                "start": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                "end": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                "length_m": { "$ref": "#/definitions/measurement" },
                "openings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["opening_id", "type", "position_along_wall_m", "width_m"],
                    "properties": {
                      "opening_id": { "type": "string" },
                      "type": { "type": "string", "enum": ["door", "window"] },
                      "position_along_wall_m": { "type": "number" },
                      "width_m": { "$ref": "#/definitions/measurement" },
                      "sill_m": { "type": "number" },
                      "head_m": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "damage_regions": { "type": "array" },
          "concealed_damage_flags": { "type": "array" },
          "scope_line_items": { "type": "array" }
        }
      }
    },
    "drift": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "ablation": { "type": "object", "properties": { "on": { "type": ["number", "null"] }, "off": { "type": ["number", "null"] } } }
      }
    },
    "confidence": {
      "type": "object",
      "properties": { "calibration_factor": { "type": "number" }, "method": { "type": "string" } }
    },
    "artifacts": { "type": "object" }
  },
  "definitions": {
    "measurement": {
      "type": "object",
      "required": ["value", "ci95", "method"],
      "properties": {
        "value": { "type": "number" },
        "ci95": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "method": { "type": "string" }
      }
    }
  }
}
